# PostgreSQL connection used by the application and docker-compose.
# Copy this file to .env and adjust values as needed. Never commit the real .env file.

DB_URL=jdbc:postgresql://localhost:5433/portfolio_db
DB_USERNAME=portfolio_user
DB_PASSWORD=portfolio_pass
DB_NAME=portfolio_db

# Port the app listens on when run directly with `mvn spring-boot:run` (not used inside Docker).
SERVER_PORT=8080

# Host-side ports used by docker-compose (changed from the Postgres/Spring Boot defaults
# 5432/8080 to avoid clashing with other local projects).
DB_PORT=5433
API_PORT=8081
